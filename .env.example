# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...). También funciona la anon key legacy
# con el nombre NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase: SÓLO servidor (nunca con prefijo NEXT_PUBLIC_) ---
# Service role / secret key. Se usa únicamente para: resolver el nombre de usuario
# al iniciar sesión y crear/editar cuentas desde /admin (API de Auth Admin).
# Obligatoria para iniciar sesión con usuario y para `npm run admin:create`.
# También limita los intentos de login y el cupo diario de Garfield (tabla rate_limit_events).
# Acepta también el nombre nuevo de Supabase: SUPABASE_SECRET_KEY (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=
# Dominio de los emails internos que Supabase Auth necesita (no se envían correos).
# Cámbialo sólo antes de crear usuarios.
# AUTH_USERNAME_DOMAIN=usuarios.invalid

# --- Sitio ---
# URL pública sin "/" final. Se usa en canonical, Open Graph y enlaces del PDF.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nombre comercial de la plataforma.
NEXT_PUBLIC_APP_NAME=Vitrina
# "false" desactiva el optimizador de imágenes de Vercel (control de costos).
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# --- Garfield AI (asistente del editor) ---
# Sin ninguna clave, Garfield funciona en "modo básico" (entiende pedidos directos).
# Claves SÓLO de servidor: nunca con prefijo NEXT_PUBLIC_.
#
# Opción recomendada (gratis): Google Gemini. Crea la clave en https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# Modelos en orden (si el primero agota su cuota diaria, usa el siguiente; al final, modo básico).
# ASSISTANT_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
#
# Alternativa de pago: Claude (Anthropic).
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-sonnet-5-5
#
# Cualquier API compatible con OpenAI (Ollama local, Mistral, Groq, OpenRouter…):
# ASSISTANT_PROVIDER=openai-compatible
# ASSISTANT_BASE_URL=http://localhost:11434/v1
# ASSISTANT_API_KEY=
# ASSISTANT_MODEL=qwen3
# Nombre que se muestra para ese proveedor (por defecto "openai-compatible").
# ASSISTANT_PROVIDER_NAME=ollama
#
# Opcional: esfuerzo de razonamiento para modelos que lo soportan (low | medium | high).
# ASSISTANT_REASONING_EFFORT=low
#
# Router de Garfield: local-first (por defecto: lo simple se resuelve sin IA, gratis e instantáneo),
# llm-first (todo al modelo) o local-only (nunca usa IA).
# ASSISTANT_ROUTING=local-first
#
# Opcional: fuerza el proveedor (gemini | anthropic | openai-compatible | basic).
# Si falta, se usa el de la clave disponible: GEMINI_API_KEY → ANTHROPIC_API_KEY → ASSISTANT_BASE_URL.
# ASSISTANT_PROVIDER=gemini

# --- Aviso semanal por correo ("Revisa tu catálogo") ---
# Los lunes a las 15:00 UTC (Vercel Cron, vercel.json) se envía un resumen a quienes
# administran un negocio con productos sin foto, sin precio o sin categoría.
# Sin estas tres variables corre en modo de prueba (calcula, no envía).
# Clave de https://resend.com (SÓLO servidor).
# RESEND_API_KEY=re_...
# Remitente de un dominio verificado en Resend.
# EMAIL_FROM=Vitrina <avisos@tudominio.com>
# Secreto aleatorio (16+ caracteres): Vercel lo manda al llamar al cron y firma los
# enlaces de baja. Genéralo con: openssl rand -base64 32
# CRON_SECRET=

# --- Avisos de pedidos al instante (notificaciones push) ---
# Sin estas claves la tarjeta "Avisos de pedidos" dice que no están configurados.
# Genéralas UNA vez con:  npx web-push generate-vapid-keys
# (la pública va al navegador; la privada es SÓLO servidor. Si cambian, cada usuario vuelve a activar los avisos.)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (mailto: o https://).
# VAPID_SUBJECT=mailto:avisos@tudominio.com

# --- Opcional: sólo para `npm run db:types` ---
# SUPABASE_PROJECT_ID=xxxxxxxxxxxx

# --- Dominio propio por negocio (API de Vercel) ---
# Sin estas dos, la tarjeta "Dominio propio" del panel dice que todavía no está disponible.
# Token con acceso al proyecto: Vercel → Account Settings → Tokens. SÓLO servidor y sólo en Production
# (una vista previa no debe conectar dominios al proyecto real).
# VERCEL_API_TOKEN=
# ID del proyecto: Project → Settings → General (prj_…).
# VERCEL_PROJECT_ID=
# ID del equipo dueño del proyecto (team_…), si aplica: Team → Settings → General.
# VERCEL_TEAM_ID=

# --- Cuenta demo («Probar el panel») ---
# Disponible por defecto si hay service role. "off" la apaga.
# Las demos vencidas las borra el cron diario /api/cron/demo-cleanup (necesita CRON_SECRET).
# DEMO_ACCOUNTS=on
