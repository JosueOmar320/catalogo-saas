{
  "name": "catalogo-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS to build a website, product catalog and PDF for small businesses, with an AI assistant. Next.js 16 + Supabase (RLS).",
  "author": "Josue Flores (https://github.com/JosueOmar320)",
  "license": "UNLICENSED",
  "homepage": "https://catalogo-saas-nu.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosueOmar320/catalogo-saas.git"
  },
  "bugs": {
    "url": "https://github.com/JosueOmar320/catalogo-saas/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:retry": "node scripts/build-retry.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --conditions=react-server --import tsx --test \"tests/**/*.test.ts\"",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
    "test:coverage": "node --conditions=react-server --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=75 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/**/*.test.ts\"",
    "test:db": "node supabase/tests/rls.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:app": "node scripts/e2e-app.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run test:db",
    "db:types": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.generated.ts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "postcss": "8.5.31",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@react-pdf/types": "^2.14.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
